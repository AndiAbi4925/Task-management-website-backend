generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  title     String?  @default("Concierge Staff")
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  status        String   @default("Pending")
  checkInDate   String?
  dueDate       String?
  
  // The new fields MUST be here
  bedType       String?   @default("King")
  isSmoking     Boolean   @default(false)
  hasConnecting Boolean   @default(false)
  hasBreakfast  Boolean   @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
}